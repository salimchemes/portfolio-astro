---
import BaseHead from '../components/BaseHead.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Bienvenido" description="Bienvenido Nasif!!" />
	</head>
	<body>
		<main class="welcome">
			<div class="stars"></div>
			<h1 class="welcome-title">
				<span>BIENVENIDO</span>
				<span class="highlight">NASIF!!</span>
			</h1>
			<div class="confetti">
				{Array.from({ length: 30 }).map((_, i) => (
					<span class="confetti-piece" style={`--i:${i}`}></span>
				))}
			</div>
		</main>
	</body>
</html>

<style>
		html,
	body {
		height: 100%;
	}

	body {
		background: none;
	}

	.welcome {
		/* override the global `main` width/margin constraint to fill the viewport */
		width: 100vw;
		max-width: none;
		margin: 0;
		position: relative;
		height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		/* keep content clear of TV overscan cropping */
		padding: 8vh 8vw;
		box-sizing: border-box;
		background: linear-gradient(-45deg, #ff6b6b, #f7b733, #6a11cb, #2575fc);
		background-size: 400% 400%;
		animation: gradientShift 10s ease infinite;
	}

	@keyframes gradientShift {
		0% { background-position: 0% 50%; }
		50% { background-position: 100% 50%; }
		100% { background-position: 0% 50%; }
	}

	.welcome-title {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
		/* large, bold sizing so it reads clearly from across a room */
		font-size: clamp(3.5rem, 12vw, 11rem);
		line-height: 1.05;
		font-weight: 900;
		letter-spacing: 0.02em;
		text-align: center;
		color: #fff;
		text-shadow:
			0 0 20px rgba(255, 255, 255, 0.8),
			0 4px 12px rgba(0, 0, 0, 0.5);
		animation: pop-in 0.8s cubic-bezier(0.26, 1.36, 0.6, 1) both;
	}

	.welcome-title .highlight {
		color: #fff44f;
		animation: bounce 1.6s ease-in-out infinite;
		text-shadow:
			0 0 10px #fff44f,
			0 0 30px #ff6b6b,
			0 0 60px #6a11cb;
	}

	@keyframes pop-in {
		0% {
			opacity: 0;
			transform: scale(0.4) rotate(-8deg);
		}
		100% {
			opacity: 1;
			transform: scale(1) rotate(0deg);
		}
	}

	@keyframes bounce {
		0%, 100% { transform: translateY(0) scale(1); }
		50% { transform: translateY(-14px) scale(1.05); }
	}

	.stars {
		position: absolute;
		inset: 0;
		background-image: radial-gradient(2px 2px at 20% 30%, #fff, transparent),
			radial-gradient(2px 2px at 60% 70%, #fff, transparent),
			radial-gradient(1.5px 1.5px at 80% 20%, #fff, transparent),
			radial-gradient(1.5px 1.5px at 40% 80%, #fff, transparent),
			radial-gradient(2px 2px at 90% 60%, #fff, transparent),
			radial-gradient(1.5px 1.5px at 10% 90%, #fff, transparent);
		opacity: 0.6;
		animation: twinkle 3s ease-in-out infinite alternate;
	}

	@keyframes twinkle {
		0% { opacity: 0.3; }
		100% { opacity: 0.8; }
	}

	.confetti {
		position: absolute;
		inset: 0;
		pointer-events: none;
		z-index: 1;
	}

	.confetti-piece {
		position: absolute;
		top: -10%;
		left: calc(var(--i) * 3.4%);
		width: 22px;
		height: 22px;
		background: hsl(calc(var(--i) * 12), 90%, 60%);
		opacity: 0.9;
		animation: fall linear infinite;
		animation-duration: calc(4s + (var(--i) * 0.13s));
		animation-delay: calc(var(--i) * -0.2s);
	}

	.confetti-piece:nth-child(odd) {
		border-radius: 50%;
	}

	@keyframes fall {
		0% {
			transform: translateY(0) rotate(0deg);
		}
		100% {
			transform: translateY(110vh) rotate(360deg);
		}
	}
</style>
