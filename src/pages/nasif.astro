---
import BaseHead from '../components/BaseHead.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Bienvenido" description="Bienvenido Nasif!!" />
	</head>
	<body>
		<main class="welcome">
			<h1 class="welcome-title">
				<span>BIENVENIDO</span>
				<span class="highlight">NASIF!!</span>
			</h1>
		</main>
	</body>
</html>

<style>
	html,
	body {
		height: 100%;
	}

	body {
		background: none;
	}

	.welcome {
		/* override the global `main` width/margin constraint to fill the viewport */
		width: 100vw;
		max-width: none;
		margin: 0;
		height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		box-sizing: border-box;
		/* keep content clear of TV overscan cropping */
		padding: 8vh 8vw;
		background: #2337ff;
	}

	.welcome-title {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
		/* large, bold sizing so it reads clearly from across a room */
		font-size: clamp(3.5rem, 12vw, 11rem);
		line-height: 1.05;
		font-weight: 900;
		letter-spacing: 0.02em;
		text-align: center;
		color: #fff;
	}

	.welcome-title .highlight {
		color: #fff44f;
	}
</style>
