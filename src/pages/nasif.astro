---
import BaseHead from '../components/BaseHead.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Bienvenido" description="Bienvenido Nasif!!" />
	</head>
	<body>
		<div class="welcome">
			<h1 class="welcome-title">
				<span>BIENVENIDO</span>
				<span class="highlight">NASIF!!</span>
			</h1>
		</div>
	</body>
</html>

<style is:global>
	html,
	body {
		height: 100%;
		margin: 0;
		background: #2337ff;
	}
</style>

<style>
	.welcome {
		/* anchor to the viewport with fixed positioning instead of vh/vw,
		   which some TV browsers mishandle and reflow endlessly */
		position: fixed;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		box-sizing: border-box;
		padding: 5%;
	}

	.welcome-title {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
		font-size: 6rem;
		line-height: 1.05;
		font-weight: 900;
		letter-spacing: 0.02em;
		text-align: center;
		color: #fff;
	}

	.welcome-title .highlight {
		color: #fff44f;
	}
</style>
